# Root .env for docker compose (copy to .env and fill in real values).
# docker-compose.yml refuses to start if JWT_SECRET or SUPER_ADMIN_PASSWORD is missing.
# MONGO_URI and PORT are set inside docker-compose.yml for the containers.

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=30d
SUPER_ADMIN_EMAIL=admin@multimart.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
