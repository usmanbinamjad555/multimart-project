# Backend environment (copy to backend/.env for local, non-Docker development)

MONGO_URI=mongodb://localhost:27017/multimart
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=30d
PORT=8081
CLIENT_URL=http://localhost:5173
SUPER_ADMIN_EMAIL=admin@multimart.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
